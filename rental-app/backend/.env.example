# Copy this file to .env and fill in your real values before running the server.

# Your MongoDB Atlas connection string (see README for how to get this --
# free tier, no expiry). Looks like:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rental-app
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/rental-app

# Used to sign admin login sessions. Change this to any long random string.
JWT_SECRET=change-this-to-a-long-random-string

# The single owner/admin login. These are read directly from here every
# time the server starts -- to change the password, just edit this value
# and restart the server (no re-seeding needed).
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-password

# Your UPI ID (the one customers will pay to), e.g. yourname@okhdfcbank
UPI_ID=owner@upi
UPI_PAYEE_NAME=Alex Cars

# Port the API server listens on
PORT=4000

# Comma separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173
